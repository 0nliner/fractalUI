{
  "name": "@fractalui/tokens",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": ["**/*.css", "**/*.css.ts"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.17.0"
  },
  "devDependencies": {
    "@vanilla-extract/esbuild-plugin": "^2.3.16",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
