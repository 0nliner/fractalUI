{
  "name": "@fractalui/runtime",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.css.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fractalui/tokens": "workspace:*",
    "@fractalui/icons": "workspace:*",
    "@fractalui/primitives": "workspace:*",
    "@fractalui/patterns": "workspace:*",
    "@fractalui/data": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "react-router-dom": "^6 || ^7"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "description": "Config-driven runtime/renderer for fractalUI",
  "license": "MIT",
  "author": "Aleksandr Chudaikin",
  "homepage": "https://0nliner.github.io/fractalUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0nliner/fractalUI.git",
    "directory": "packages/runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "headless",
    "components",
    "fractalui",
    "vanilla-extract"
  ]
}
