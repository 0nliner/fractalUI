{
  "name": "@fractalui/data",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "zustand": "^5"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "description": "Data utilities for the fractalUI kit",
  "license": "MIT",
  "author": "Aleksandr Chudaikin",
  "homepage": "https://0nliner.github.io/easyUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0nliner/easyUI.git",
    "directory": "packages/data"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "headless",
    "components",
    "fractalui",
    "vanilla-extract"
  ]
}
